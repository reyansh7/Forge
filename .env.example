# Local-only development defaults.
# Copy to `.env` (gitignored). Do not use these values in production.
#
# Compose interpolates this file for docker-compose.yml.
# `go run ./cmd/api` loads it via internal/config so both share the same URLs.

# HTTP bind for the control-plane API (loopback, not 0.0.0.0).
FORGE_API_ADDR=127.0.0.1:8080

# Postgres role created by the official image on first boot.
FORGE_POSTGRES_USER=forge
FORGE_POSTGRES_PASSWORD=forge
FORGE_POSTGRES_DB=forge

# Host port mapped to container 5432. 15432 avoids a common Windows clash
# with a native Postgres already bound to 5432.
FORGE_POSTGRES_HOST_PORT=15432

# The API talks to Postgres on the *host* port (15432), not 5432 inside
# the container. sslmode=disable is local-only.
FORGE_DATABASE_URL=postgres://forge:forge@127.0.0.1:15432/forge?sslmode=disable

FORGE_REDIS_URL=redis://127.0.0.1:6379/0
