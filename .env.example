# Local-only development defaults.
# Copy to `.env` (gitignored). Do not use these values in production.
#
# Compose interpolates this file for docker-compose.yml.
# `go run ./cmd/api` loads it via internal/config so both share the same URLs.

# HTTP bind for the control-plane API (loopback, not 0.0.0.0).
FORGE_API_ADDR=127.0.0.1:8080

# Phase 3: the first operator is created via POST /auth/bootstrap (dashboard
# /login) when the users table is empty. Do not put a password here.

# Postgres role created by the official image on first boot.
FORGE_POSTGRES_USER=forge
FORGE_POSTGRES_PASSWORD=forge
FORGE_POSTGRES_DB=forge

# Host port mapped to container 5432. 15432 avoids a common Windows clash
# with a native Postgres already bound to 5432.
FORGE_POSTGRES_HOST_PORT=15432

# The API talks to Postgres on the *host* port (15432), not 5432 inside
# the container. sslmode=disable is local-only.
FORGE_DATABASE_URL=postgres://forge:forge@127.0.0.1:15432/forge?sslmode=disable

FORGE_REDIS_URL=redis://127.0.0.1:6379/0

# Worker → Caddy admin (Compose publishes 2019 on loopback only).
FORGE_CADDY_ADMIN_URL=http://127.0.0.1:2019
FORGE_CADDY_UPSTREAM_HOST=host.docker.internal
FORGE_PROXY_PUBLIC_BASE=http://127.0.0.1:9080

# Phase 5 — optional API TLS (both or neither). Generate with:
#   go run ./cmd/forge-cert
# FORGE_TLS_CERT_FILE=.forge/tls/cert.pem
# FORGE_TLS_KEY_FILE=.forge/tls/key.pem

# Env-at-rest key. Empty = create/read .forge/data.key. API and worker
# must share it. Never commit the file or paste the hex into chat.
# FORGE_DATA_KEY=
# FORGE_DATA_KEY_FILE=.forge/data.key

# Quotas (defaults shown). Disk cap is on the fetched workspace, not the container.
# FORGE_MAX_PROJECTS_PER_OWNER=20
# FORGE_MAX_INFLIGHT_DEPLOYS=2
# FORGE_LOG_RETENTION_DAYS=14
# FORGE_WORKSPACE_MAX_BYTES=268435456

# Required to bind 0.0.0.0. Auth is still required. Prefer TLS if you set this.
# FORGE_ALLOW_PUBLIC_BIND=
